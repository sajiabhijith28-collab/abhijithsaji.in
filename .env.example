# ==============================================================================
# "My Dr" — Hospital & Doctor Appointment Booking Platform
# Copy this file to .env.local and populate your credentials.
# When Supabase keys are omitted, the app runs seamlessly using its pre-seeded
# server-side Demo Store + Razorpay Test Simulator + OTP Test Console.
# ==============================================================================

# Production Domain URL (www.abhijithsaji.in)
NEXT_PUBLIC_APP_URL=https://www.abhijithsaji.in

# Optional Persistent Volume Directory (for Railway / VPS deployments, e.g. /data)
MYDR_DATA_DIR=

# Auth Session Signing Secret (used for HTTP-only session cookies)
AUTH_SESSION_SECRET=change-me-to-a-long-random-32-byte-secret-in-production

# ------------------------------------------------------------------------------
# 1. SUPABASE (Postgres, Phone Auth, RLS, Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. ONLINE PLATFORM FEE PAYMENTS (Direct UPI ID — Default, or Optional Razorpay)
# ------------------------------------------------------------------------------
ADMIN_UPI_ID=pksaji020@oksbi
ADMIN_UPI_PAYEE_NAME="My Dr Healthcare"

# Optional Razorpay Gateway (only required if switching Payment Mode to Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 3. MOBILE OTP & SMS PROVIDER ("fast2sms" | "twofactor" | "msg91" | "twilio" | "supabase_native" | "dev_console")
# ------------------------------------------------------------------------------
SMS_PROVIDER=dev_console

# Optional Fast2SMS India Instant OTP (when SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=

# Optional 2Factor.in India Instant OTP (when SMS_PROVIDER=twofactor)
TWOFACTOR_API_KEY=

# Optional MSG91 Config (when SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=MYDRIN

# Optional Twilio Config (when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------------------------
# 4. INITIAL BOOTSTRAP ADMIN CREDENTIALS (for local/initial seed only)
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_PHONE=+919000000001
ADMIN_BOOTSTRAP_EMAIL=admin@mydr.in
ADMIN_BOOTSTRAP_PASSWORD=

